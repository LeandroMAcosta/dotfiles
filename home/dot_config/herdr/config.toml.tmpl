# herdr configuration
# Deployed to ~/.config/herdr/config.toml by install.sh
# Full default reference: herdr --default-config
# Apply edits to a running server with: herdr server reload-config

[theme]
# Matches the Catppuccin theme used by the tmux status bar.
name = "catppuccin"

# Follow iTerm's light/dark appearance instead of pinning one theme.
auto_switch = true
dark_name = "catppuccin"
light_name = "catppuccin-latte"

[terminal]
# Login shells so panes get the full environment (PATH, 1Password plugins,
# secrets.env). "auto" already does this on macOS; pinned for clarity.
shell_mode = "login"

# New panes inherit the cwd of the pane they were created from.
new_cwd = "follow"

# i3-style direct bindings: hold alt and press, no prefix tap first. alt is the
# $mod equivalent, matching the tilish bindings already used in tmux.
#
# alt+ chords are only reliable because macos.sh sets iTerm's Option Key Sends
# to Esc+ on both Option keys. Without that, macOS composes accented characters
# instead of sending a modifier and none of these fire.
#
# Every action also keeps its prefix binding (ctrl+a) as a fallback path, so a
# chord that collides with something else is never the only way in.
# prefix+? lists whatever is actually bound.
[keys]
prefix = "ctrl+a"

# Focus panes. Arrow keys are the primary binding; h/j/k/l stay bound so the
# vim-style shortcuts in the docs and in tmux still work, but nothing forces
# their use.
focus_pane_left = ["prefix+left", "alt+left", "prefix+h", "alt+h"]
focus_pane_down = ["prefix+down", "alt+down", "prefix+j", "alt+j"]
focus_pane_up = ["prefix+up", "alt+up", "prefix+k", "alt+k"]
focus_pane_right = ["prefix+right", "alt+right", "prefix+l", "alt+l"]

# Jump back to the previously focused pane. Unset by default in herdr. With two
# splits a toggle beats directional movement: one key, no thinking about which
# way to go. prefix+; mirrors tmux's last-pane binding. Note prefix+prefix is
# reserved by herdr (it sends a literal prefix key), so the tmux double-tap
# idiom is not available here.
last_pane = ["prefix+;", "alt+o"]

# Resize without entering resize mode (alt+r). Unset by default in herdr.
resize_pane_left = "alt+shift+left"
resize_pane_down = "alt+shift+down"
resize_pane_up = "alt+shift+up"
resize_pane_right = "alt+shift+right"

# Splits — i3 $mod+v
split_vertical = ["prefix+v", "alt+v"]
split_horizontal = ["prefix+minus", "alt+minus"]

# Tabs behave like i3 workspaces — $mod+1..9.
# alt+1..9 is not bound here: herdr's switch_tab does nothing when the tab does
# not exist yet, while i3 creates the workspace on demand. The [[keys.command]]
# blocks at the end of this file bind alt+1..9 to goto-tab.sh, which focuses
# the tab or creates it first. prefix+1..9 keeps the plain built-in behaviour.
switch_tab = "prefix+1..9"
new_tab = ["prefix+c", "alt+enter"]
next_tab = ["prefix+n", "alt+]"]
previous_tab = ["prefix+p", "alt+["]
close_tab = ["prefix+shift+x", "alt+shift+x"]

# Panes — i3 $mod+shift+q kills, $mod+f fullscreens, $mod+r resizes
close_pane = ["prefix+x", "alt+shift+q"]
zoom = ["prefix+z", "alt+z"]
resize_mode = ["prefix+r", "alt+r"]

# Workspaces
workspace_picker = ["prefix+w", "alt+w"]
new_workspace = ["prefix+shift+n", "alt+shift+n"]
switch_workspace = ["prefix+shift+1..9", "alt+shift+1..9"]

# Misc — i3 $mod+shift+c reloads config
toggle_sidebar = ["prefix+b", "alt+shift+b"]
reload_config = ["prefix+shift+r", "alt+shift+c"]

# alt+1..9 — go to tab N, creating it when it is missing (see switch_tab above).
# type = "shell" runs detached, so no pane flashes up. herdr does not expand ~
# or $HOME inside keys.command, so chezmoi renders the absolute home path here
# at apply time.

[[keys.command]]
key = "alt+1"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 1"

[[keys.command]]
key = "alt+2"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 2"

[[keys.command]]
key = "alt+3"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 3"

[[keys.command]]
key = "alt+4"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 4"

[[keys.command]]
key = "alt+5"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 5"

[[keys.command]]
key = "alt+6"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 6"

[[keys.command]]
key = "alt+7"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 7"

[[keys.command]]
key = "alt+8"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 8"

[[keys.command]]
key = "alt+9"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/goto-tab.sh 9"
